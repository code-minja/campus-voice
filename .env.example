# ── Campus Voice — Environment Variables ─────────────────────────────────────
# Copy to .env and adjust as needed.
# All values shown are defaults — you only need to set what you want to change.

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="" 				# Provide a value for APP_NAME
DEBUG="" 				# Provide a value for DEBUG
LOG_LEVEL="" 				# Provide a value for LOG_LEVEL

# ── Server ────────────────────────────────────────────────────────────────────
HOST="" 				# Provide a value for HOST
PORT="" 				# Provide a value for PORT
WORKERS="" 				# Provide a value for WORKERS

# ── STT ───────────────────────────────────────────────────────────────────────
# Model sizes: tiny | base | small | medium | large-v3
# Larger = more accurate, slower, more RAM. 'base' is a good default.
WHISPER_MODEL_SIZE="" 				# Provide a value for WHISPER_MODEL_SIZE
WHISPER_DEVICE="" 				# Provide a value for WHISPER_DEVICE
WHISPER_COMPUTE_TYPE="" 				# Provide a value for WHISPER_COMPUTE_TYPE
WHISPER_DOWNLOAD_ROOT="" 				# Provide a value for WHISPER_DOWNLOAD_ROOT

# ── TTS ───────────────────────────────────────────────────────────────────────
# Kokoro voices: af_heart | af_bella | am_adam | am_michael | bf_emma | bm_george
KOKORO_VOICE="" 				# Provide a value for KOKORO_VOICE
KOKORO_LANG="" 				# Provide a value for KOKORO_LANG
KOKORO_SPEED="" 				# Provide a value for KOKORO_SPEED

# ── Audio output ──────────────────────────────────────────────────────────────
TTS_SAMPLE_RATE="" 				# Provide a value for TTS_SAMPLE_RATE
TTS_OUTPUT_FORMAT="" 				# Provide a value for TTS_OUTPUT_FORMAT

# ── CORS ──────────────────────────────────────────────────────────────────────
# For production, restrict to your Expo app origin
CORS_ORIGINS="" 				# Provide a value for CORS_ORIGINS

# ── Campus geofence / route simulation ───────────────────────────────────────
CAMPUS_GEOFENCE_ENABLED="" 				# Provide a value for CAMPUS_GEOFENCE_ENABLED
CAMPUS_CENTER_LATITUDE="" 				# Provide a value for CAMPUS_CENTER_LATITUDE
CAMPUS_CENTER_LONGITUDE="" 				# Provide a value for CAMPUS_CENTER_LONGITUDE
CAMPUS_GEOFENCE_RADIUS_METERS="" 				# Provide a value for CAMPUS_GEOFENCE_RADIUS_METERS
ALLOW_SIMULATED_ORIGIN="" 				# Provide a value for ALLOW_SIMULATED_ORIGIN

# ── Routing provider ────────────────────────────────────────────────────────
# Use `mock` for local testing. Set to `google_routes` after enabling the
# Google Routes API and adding a valid API key.
# ROUTING_PROVIDER=mock
ROUTING_PROVIDER="" 				# Provide a value for ROUTING_PROVIDER
GOOGLE_MAPS_API_KEY="" 				# Provide a value for GOOGLE_MAPS_API_KEY
GOOGLE_ROUTES_LANGUAGE_CODE="" 				# Provide a value for GOOGLE_ROUTES_LANGUAGE_CODE
GOOGLE_ROUTES_UNITS="" 				# Provide a value for GOOGLE_ROUTES_UNITS